# Copy to .env and fill in. Never commit .env.

# PostgreSQL 16 with PostGIS; the role should own the database (not a superuser)
DATABASE_URL=postgres://tiffin:change-me@localhost:5432/tiffin

# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Password given to the seeded sample users (npm run seed)
SEED_PASSWORD=

# Optional: enables Sign in with Google (OAuth client ID; not a secret)
GOOGLE_CLIENT_ID=

# Optional settings (defaults shown)
# NODE_ENV=development
# PORT=3000
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
# BCRYPT_COST=12
# JOBS_ENABLED=true

# Payments: "fake" works offline; "razorpay" needs test keys (rzp_test_...)
# PAYMENT_PROVIDER=fake
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
